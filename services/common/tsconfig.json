{
  "compilerOptions": {
    "declaration": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "outDir": "dist",
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@microrealestate/types": ["../../types/src"]
    }
  },
  "include": ["src/**/*"],
  "references": [
    { "path": "../../types" }
  ]
}
